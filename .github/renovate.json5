{
  // Dependency update automation — implements the two-lane flow in review/22.
  // Renovate opens PRs (or Dashboard-approval rows) so pins never rot past
  // security/beneficial updates, without sacrificing reproducibility.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":dependencyDashboard", // single self-updating issue unifying all pending bumps
    ":semanticCommits",
    "helpers:pinGitHubActionDigests", // keep Actions on 40-hex SHAs (GH#734)
  ],
  timezone: "America/Chicago",
  schedule: ["before 9am on monday"],
  labels: ["type:infrastructure", "deps"],
  packageRules: [
    // ---- HYGIENE LANE: flows through with ~zero attention ----
    {
      // Python dev/test tooling — matched by name (pep621 optional-dependencies has
      // no per-extra depType granularity, so target the actual tool packages).
      matchManagers: ["pep621", "pip_requirements", "pip-compile"],
      matchPackageNames: ["ruff", "pytest", "pip-tools"],
      matchUpdateTypes: ["patch", "minor"],
      groupName: "python dev/test tooling (hygiene)",
      automerge: true, // on green CI
    },
    {
      // npm dev tooling (the Cloudflare Worker).
      matchManagers: ["npm"],
      matchDepTypes: ["devDependencies"],
      matchUpdateTypes: ["patch", "minor"],
      groupName: "npm dev tooling (hygiene)",
      automerge: true,
    },
    {
      // Non-output-affecting Python runtime libs: grouped PRs, reviewed, not auto-merged.
      matchManagers: ["pep621", "pip_requirements", "pip-compile"],
      matchPackageNames: ["requests", "PyYAML", "Jinja2", "defusedxml", "boto3", "jiwer"],
      groupName: "python runtime (hygiene)",
    },
    // Actions & workflow files are SHA-pinned but NEVER auto-merged (a compromised
    // update could move a pinned SHA — see review/22 / the Renovate malicious-SHA caveat).
    {
      matchManagers: ["github-actions"],
      automerge: false,
      groupName: "github actions (SHA-pinned)",
    },
    // gh CLI pin (constraints/gh-cli.txt, see its header for the 2026-07-27 incident).
    // Same caveat as the SHA-pinned Actions above: never auto-merged, since a compromised
    // gh release is exactly the class of risk a rubber-stamped automerge would let through.
    // Renovate bumps only GH_CLI_VERSION here -- it does not touch the adjacent
    // GH_CLI_SHA256_LINUX_AMD64 pin, so this PR's CI fails on a checksum mismatch until a
    // human fetches the new release's real hash and adds it, by design (see gh-cli.txt).
    {
      matchDepNames: ["cli/cli"],
      automerge: false,
      groupName: "gh CLI (pinned, hash verified against a human-reviewed pin)",
    },
    // ---- OUTPUT-AFFECTING LANE: one checkbox + one bot comment ----
    // Renovate lists these under "Pending Approval" on the Dashboard and opens no
    // PR until a human ticks the box. When the PR opens, dep-bump-smoke.yml proves
    // whether produced bytes changed (per-source), gating the merge decision.
    {
      // Named Python inference/imaging libs that affect produced bytes.
      matchManagers: ["pep621", "pip_requirements", "pip-compile"],
      matchPackageNames: ["faster-whisper", "ctranslate2", "whisperx", "Pillow"],
      groupName: "output-affecting: python (needs approval + smoke)",
      dependencyDashboardApproval: true,
      automerge: false,
      labels: ["type:infrastructure", "deps", "output-affecting"],
      schedule: ["at any time"], // approval is the gate, not a cadence
    },
    {
      // The custom-regex + Dockerfile output-affecting pins: base image digest and the
      // HF model revisions (static ffmpeg is no longer Renovate-tracked — see the
      // customManagers comment below). Separate rule so these actually reach the
      // approval lane (matchers of different types are AND-ed together).
      matchManagers: ["custom.regex", "dockerfile"],
      groupName: "output-affecting: image/ffmpeg/model (needs approval + smoke)",
      dependencyDashboardApproval: true,
      automerge: false,
      labels: ["type:infrastructure", "deps", "output-affecting"],
      schedule: ["at any time"],
    },
  ],
  // Static ffmpeg (FFMPEG_SHA256 in the 7 workflows that pin it, plus the version embedded in the
  // deps/ffmpeg/<version>/... B2 key) is no longer Renovate-tracked here. It's self-built from
  // github.com/FFmpeg/FFmpeg source and vendored into our own B2 bucket
  // (scripts/build_ffmpeg_static.sh, .github/workflows/build-ffmpeg.yml) rather than fetched from
  // an upstream/mirror release URL on every run — a regex bump against a URL pattern doesn't apply
  // anymore, and Renovate can't run the build+vendor step itself. Bumping the version is manual:
  // dispatch build-ffmpeg.yml with the new version, then update the 7 workflows' FFMPEG_SHA256 and
  // the "7.1.5" path segment in their FFMPEG_URL to match (still output-affecting, still
  // smoke-gated — review/22).
  customManagers: [
    {
      // Hugging Face Whisper model revisions (GH#498). Requires the huggingface
      // datasource; output-affecting → Dashboard approval.
      customType: "regex",
      managerFilePatterns: ["/^citypods/asr\\.py$/"],
      matchStrings: [
        "(?<depName>[\\w-]+/[\\w.-]+)\"\\s*#\\s*renovate\\s*\\n\\s*HF_\\w+_REVISION\\s*=\\s*\"(?<currentDigest>[a-f0-9]+)\"",
      ],
      datasourceTemplate: "huggingface",
    },
    {
      // Pinned gh CLI version (constraints/gh-cli.txt, installed by
      // .github/actions/setup-gh-cli). Only the version is tracked here — a human must also
      // update the adjacent GH_CLI_SHA256_LINUX_AMD64 pin by hand (this regex intentionally
      // doesn't touch it), or the resulting PR's CI fails on a checksum mismatch.
      customType: "regex",
      managerFilePatterns: ["/^constraints/gh-cli\\.txt$/"],
      matchStrings: [
        "renovate:\\s*datasource=github-releases depName=cli/cli\\s*\\n\\s*GH_CLI_VERSION=(?<currentValue>[\\d.]+)",
      ],
      datasourceTemplate: "github-releases",
      depNameTemplate: "cli/cli",
    },
  ],
}
