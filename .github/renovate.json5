{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
    ':semanticCommits',
    'helpers:pinGitHubActionDigests',
  ],
  timezone: 'America/Chicago',
  schedule: [
    'before 9am on monday',
  ],
  labels: [
    'type:infrastructure',
    'deps',
  ],
  packageRules: [
    {
      matchManagers: [
        'pep621',
        'pip_requirements',
        'pip-compile',
      ],
      matchPackageNames: [
        'ruff',
        'pytest',
        'pip-tools',
        'setuptools',
      ],
      matchUpdateTypes: [
        'patch',
        'minor',
      ],
      groupName: 'python dev/test tooling (hygiene)',
      automerge: true,
    },
    {
      matchManagers: [
        'npm',
      ],
      matchDepTypes: [
        'devDependencies',
        'dependencies',
      ],
      matchUpdateTypes: [
        'patch',
        'minor',
      ],
      groupName: 'npm tooling (hygiene)',
      automerge: true,
    },
    {
      matchManagers: [
        'pep621',
        'pip_requirements',
        'pip-compile',
      ],
      matchPackageNames: [
        'requests',
        'PyYAML',
        'Jinja2',
        'defusedxml',
        'boto3',
        'jiwer',
        'pypdf',
        'beautifulsoup4',
        'cairosvg',
        'pydantic',
        'litellm',
        'instructor',
        'scikit-learn',
      ],
      groupName: 'python runtime (hygiene)',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      automerge: false,
      groupName: 'github actions (SHA-pinned)',
    },
    {
      matchDepNames: [
        'cli/cli',
      ],
      automerge: false,
      groupName: 'gh CLI (pinned, hash verified against a human-reviewed pin)',
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      matchPackageNames: [
        'wrangler',
        'renovate',
      ],
      groupName: 'workflow tooling (hygiene)',
      automerge: false,
    },
    {
      matchManagers: [
        'pep621',
        'pip_requirements',
        'pip-compile',
      ],
      matchPackageNames: [
        'faster-whisper',
        'ctranslate2',
        'whisperx',
        'torch',
        'torchaudio',
        'torchcodec',
        'Pillow',
        'sherpa-onnx',
        'numpy',
        'opencv-python-headless',
      ],
      groupName: 'output-affecting: python (needs approval + smoke)',
      dependencyDashboardApproval: true,
      automerge: false,
      labels: [
        'type:infrastructure',
        'deps',
        'output-affecting',
      ],
      schedule: [
        'at any time',
      ],
    },
    {
      matchManagers: [
        'custom.regex',
        'dockerfile',
      ],
      matchPackageNames: [
        '!wrangler',
        '!renovate',
      ],
      groupName: 'output-affecting: image/ffmpeg/model (needs approval + smoke)',
      dependencyDashboardApproval: true,
      automerge: false,
      labels: [
        'type:infrastructure',
        'deps',
        'output-affecting',
      ],
      schedule: [
        'at any time',
      ],
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/ci\\.yml$/',
      ],
      matchStrings: [
        '--package renovate@(?<currentValue>\\d+\\.\\d+\\.\\d+)',
      ],
      datasourceTemplate: 'npm',
      depNameTemplate: 'renovate',
      versioningTemplate: 'npm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
      ],
      matchStrings: [
        '(?:^|\\n)[ \t]*wranglerVersion:[ \t]*["\'](?<currentValue>\\d+\\.\\d+\\.\\d+)["\']',
        'require\\("wrangler/package\\.json"\\)\\.version\'\\)" = "(?<currentValue>\\d+\\.\\d+\\.\\d+)"',
      ],
      datasourceTemplate: 'npm',
      depNameTemplate: 'wrangler',
      versioningTemplate: 'npm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^citypods/asr\\.py$/',
      ],
      matchStrings: [
        '(?<depName>[\\w-]+/[\\w.-]+)"\\s*#\\s*renovate\\s*\\n\\s*HF_\\w+_REVISION\\s*=\\s*"(?<currentDigest>[a-f0-9]+)"',
      ],
      currentValueTemplate: '{{{currentDigest}}}',
      datasourceTemplate: 'git-refs',
      packageNameTemplate: 'https://huggingface.co/{{{depName}}}',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^constraints/gh-cli\\.txt$/',
      ],
      matchStrings: [
        'renovate:\\s*datasource=github-releases depName=cli/cli\\s*\\n\\s*GH_CLI_VERSION=(?<currentValue>[\\d.]+)',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'cli/cli',
    },
  ],
}
