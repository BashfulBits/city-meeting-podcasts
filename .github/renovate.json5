{
  // Dependency update automation — implements the two-lane flow in review/22.
  // Renovate opens PRs (or Dashboard-approval rows) so pins never rot past
  // security/beneficial updates, without sacrificing reproducibility.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":dependencyDashboard", // single self-updating issue unifying all pending bumps
    ":semanticCommits",
    "helpers:pinGitHubActionDigests", // keep Actions on 40-hex SHAs (GH#734)
  ],
  timezone: "America/Chicago",
  schedule: ["before 9am on monday"],
  labels: ["type:infrastructure", "deps"],
  // ---- PYTHON LOCKS (constraints/*.txt) ----
  // The pip-compile manager matches no files by default. Listing the four compiled lock
  // files makes Renovate read each lane's source (constraints/<lane>.in, generated from
  // pyproject.toml by scripts/lane_inputs.py) through its header, bump the lock with
  // `pip-compile --upgrade-package`, and use the Python the header was compiled with.
  // One source per lock is what makes each lane its own Renovate project: locks sharing
  // pyproject.toml would read every current version from asr.txt alone.
  // gh-cli.txt is not a pip lock (custom regex manager below).
  "pip-compile": {
    managerFilePatterns: ["/^constraints/(prod|dev|asr|chapter-research)\\.txt$/"],
  },
  // Security fixes skip the schedule and minimumReleaseAge (Renovate's vulnerabilityAlerts
  // defaults) and reach indirect locked deps too. They are labeled but never automerged
  // here: an ASR or output-affecting fix still goes through the smoke gate.
  vulnerabilityAlerts: {
    labels: ["type:infrastructure", "deps", "security"],
  },
  // OSV adds advisories GitHub lacks, including malicious-package reports (direct deps only).
  osvVulnerabilityAlerts: true,
  // Full lock refresh moves every transitive pin, ASR included, so it waits for a ticked box.
  lockFileMaintenance: {
    enabled: true,
    dependencyDashboardApproval: true,
    schedule: ["before 9am on the first day of the month"],
  },
  // pyproject.toml is read through the generated constraints/*.in above. The pep621 and
  // poetry managers would read it a second time and raise floors there on security fixes
  // (torch>=2.0 -> >=2.13.0), leaving the .in files stale and failing python-compat.yml.
  // Disabled at the manager, not by a packageRule: GitHub-alert rules are appended after
  // ours with `force`, which re-enables a dep a packageRule had disabled.
  pep621: {
    enabled: false,
  },
  poetry: {
    enabled: false,
  },
  packageRules: [
    {
      // Skip releases whose requires_python excludes the Python the locks are compiled with
      // (the ASR lane's, checked by scripts/python_lanes.py), instead of opening a PR that
      // python-compat.yml would only fail. Scoped to pip-compile: as a global setting the
      // pins below also reach the npm/regex deps, where "==7.6.2" is an invalid range.
      matchManagers: ["pip-compile"],
      constraintsFiltering: "strict",
      constraints: {
        // One value, two uses: requires_python filtering here, and the Python the hosted app
        // installs to run pip-compile. It must be a full patch version: the filter's pep440
        // matcher rejects ranges (==3.12.*) against ">=3.9", and the installer treats a bare
        // "3.12" as an exact build that doesn't exist ("install-tool python 3.12" fails).
        python: "3.12.15",
        // Keep in sync with scripts/compile_constraints.sh (>=7.5.1 writes parseable headers).
        pipTools: "==7.6.2",
      },
    },
    {
      // The python constraint above follows .github/python/asr/.python-version (the pyenv
      // rule below proposes minor bumps there); Renovate only keeps its patch current.
      matchManagers: ["renovate-config"],
      matchDepNames: ["python"],
      matchUpdateTypes: ["minor", "major"],
      enabled: false,
    },
    {
      matchManagers: ["renovate-config"],
      matchDepNames: ["python"],
      matchUpdateTypes: ["patch"],
      groupName: "renovate python patch",
      automerge: true,
    },
    // ---- HYGIENE LANE: flows through with ~zero attention ----
    {
      // Python dev/test tooling — matched by name (pep621 optional-dependencies has
      // no per-extra depType granularity, so target the actual tool packages).
      matchManagers: ["pep621", "pip_requirements", "pip-compile"],
      matchPackageNames: ["ruff", "pytest", "pip-tools", "setuptools"],
      matchUpdateTypes: ["patch", "minor"],
      groupName: "python dev/test tooling (hygiene)",
      automerge: true, // on green CI
    },
    {
      // npm dev tooling (the Cloudflare Workers).
      matchManagers: ["npm"],
      matchDepTypes: ["devDependencies", "dependencies"],
      matchUpdateTypes: ["patch", "minor"],
      groupName: "npm tooling (hygiene)",
      automerge: true,
    },
    {
      // Non-output-affecting Python runtime libs: grouped PRs, reviewed, not auto-merged.
      matchManagers: ["pep621", "pip_requirements", "pip-compile"],
      matchPackageNames: [
        "requests",
        "PyYAML",
        "Jinja2",
        "defusedxml",
        "boto3",
        "jiwer",
        "pypdf",
        "beautifulsoup4",
        "cairosvg",
        "scikit-learn",
      ],
      groupName: "python runtime (hygiene)",
    },
    {
      // LLM stack: kept at the latest release (new models and provider fixes land there).
      // Lock-only bumps (pyproject floors stay put) on any day once a release is 3 days old,
      // automerged when CI, including python-compat.yml, is green (majors excepted, below).
      matchManagers: ["pip-compile"],
      matchPackageNames: ["litellm", "instructor", "pydantic", "openai", "tiktoken"],
      groupName: "llm stack",
      rangeStrategy: "update-lockfile",
      minimumReleaseAge: "3 days",
      schedule: ["at any time"],
      automerge: true,
    },
    {
      // ...except majors (e.g. openai 2 -> 3): same lane, but a human reads the changelog.
      matchManagers: ["pip-compile"],
      matchPackageNames: ["litellm", "instructor", "pydantic", "openai", "tiktoken"],
      matchUpdateTypes: ["major"],
      automerge: false,
    },
    {
      // openai and tiktoken are transitive (via litellm), so pip-compile marks them indirect
      // and disabled. Enable just these two so the group above can move them.
      matchManagers: ["pip-compile"],
      matchDepTypes: ["indirect"],
      matchPackageNames: ["openai", "tiktoken"],
      enabled: true,
    },
    {
      // Python itself (.python-version and .github/python/asr/.python-version). A bump must
      // resolve every lane in python-compat.yml, and an ASR bump also needs the locks
      // recompiled (python_lanes.py --check fails until they are), so it waits for approval.
      matchManagers: ["pyenv"],
      dependencyDashboardApproval: true,
      automerge: false,
    },
    // Actions & workflow files are SHA-pinned but NEVER auto-merged (a compromised
    // update could move a pinned SHA — see review/22 / the Renovate malicious-SHA caveat).
    {
      matchManagers: ["github-actions"],
      automerge: false,
      groupName: "github actions (SHA-pinned)",
    },
    // gh CLI pin (constraints/gh-cli.txt, see its header for the 2026-07-27 incident).
    // Same caveat as the SHA-pinned Actions above: never auto-merged, since a compromised
    // gh release is exactly the class of risk a rubber-stamped automerge would let through.
    // Renovate bumps only GH_CLI_VERSION here -- it does not touch the adjacent
    // GH_CLI_SHA256_LINUX_AMD64 pin, so this PR's CI fails on a checksum mismatch until a
    // human fetches the new release's real hash and adds it, by design (see gh-cli.txt).
    {
      matchDepNames: ["cli/cli"],
      automerge: false,
      groupName: "gh CLI (pinned, hash verified against a human-reviewed pin)",
    },
    {
      // Workflow tooling under review/22: track exact pins on the weekly hygiene cadence.
      // Workflow changes still require review; do not auto-merge workflow-tool upgrades.
      matchManagers: ["custom.regex"],
      matchPackageNames: ["wrangler", "renovate"],
      groupName: "workflow tooling (hygiene)",
      automerge: false,
    },
    // ---- OUTPUT-AFFECTING LANE: one checkbox + one bot comment ----
    // Renovate lists these under "Pending Approval" on the Dashboard and opens no
    // PR until a human ticks the box. When the PR opens, dep-bump-smoke.yml proves
    // whether produced bytes changed (per-source), gating the merge decision.
    {
      // Named Python inference/imaging libs that affect produced bytes.
      matchManagers: ["pep621", "pip_requirements", "pip-compile"],
      matchPackageNames: [
        "faster-whisper",
        "ctranslate2",
        "whisperx",
        "torch",
        "torchaudio",
        "torchcodec",
        "Pillow",
        "sherpa-onnx",
        "numpy",
        "opencv-python-headless",
      ],
      groupName: "output-affecting: python (needs approval + smoke)",
      dependencyDashboardApproval: true,
      automerge: false,
      labels: ["type:infrastructure", "deps", "output-affecting"],
      schedule: ["at any time"], // approval is the gate, not a cadence
    },
    {
      // The custom-regex + Dockerfile output-affecting pins: base image digest and the
      // HF model revisions (static ffmpeg is no longer Renovate-tracked — see the
      // customManagers comment below). Separate rule so these actually reach the
      // approval lane (matchers of different types are AND-ed together).
      matchManagers: ["custom.regex", "dockerfile"],
      // Workflow tools have their own hygiene rule above; they do not rebuild audio/ASR artifacts.
      matchPackageNames: ["!wrangler", "!renovate"],
      groupName: "output-affecting: image/ffmpeg/model (needs approval + smoke)",
      dependencyDashboardApproval: true,
      automerge: false,
      labels: ["type:infrastructure", "deps", "output-affecting"],
      schedule: ["at any time"],
    },
  ],
  // Static ffmpeg (FFMPEG_SHA256 in the 7 workflows that pin it, plus the version embedded in the
  // deps/ffmpeg/<version>/... B2 key) is no longer Renovate-tracked here. It's self-built from
  // github.com/FFmpeg/FFmpeg source and vendored into our own B2 bucket
  // (scripts/build_ffmpeg_static.sh, .github/workflows/build-ffmpeg.yml) rather than fetched from
  // an upstream/mirror release URL on every run — a regex bump against a URL pattern doesn't apply
  // anymore, and Renovate can't run the build+vendor step itself. Bumping the version is manual:
  // dispatch build-ffmpeg.yml with the new version, then update the 7 workflows' FFMPEG_SHA256 and
  // the "7.1.5" path segment in their FFMPEG_URL to match (still output-affecting, still
  // smoke-gated — review/22).
  customManagers: [
    {
      // CI's validator must install under setup-node 24; review upgrades before merging.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/ci\\.yml$/"],
      matchStrings: ["--package renovate@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      datasourceTemplate: "npm",
      depNameTemplate: "renovate",
      versioningTemplate: "npm",
    },
    {
      // Wrangler action inputs are not package.json dependencies; track every workflow pin.
      // The package-smoke exact-version assertion is a second copy of the same pin, so track it
      // too: otherwise a Wrangler bump fails the smoke job until someone edits both by hand.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: [
        "(?:^|\\n)[ \t]*wranglerVersion:[ \t]*[\"'](?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']",
        "require\\(\"wrangler/package\\.json\"\\)\\.version'\\)\" = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
      ],
      datasourceTemplate: "npm",
      depNameTemplate: "wrangler",
      versioningTemplate: "npm",
    },
    {
      // Hugging Face Whisper model revisions (GH#498). Pinned by commit SHA via git-refs;
      // output-affecting → Dashboard approval.
      customType: "regex",
      managerFilePatterns: ["/^citypods/asr\\.py$/"],
      matchStrings: [
        "(?<depName>[\\w-]+/[\\w.-]+)\"\\s*#\\s*renovate\\s*\\n\\s*HF_\\w+_REVISION\\s*=\\s*\"(?<currentDigest>[a-f0-9]+)\"",
      ],
      currentValueTemplate: "{{{currentDigest}}}",
      datasourceTemplate: "git-refs",
      packageNameTemplate: "https://huggingface.co/{{{depName}}}",
    },
    {
      // Pinned gh CLI version (constraints/gh-cli.txt, installed by
      // .github/actions/setup-gh-cli). Only the version is tracked here — a human must also
      // update the adjacent GH_CLI_SHA256_LINUX_AMD64 pin by hand (this regex intentionally
      // doesn't touch it), or the resulting PR's CI fails on a checksum mismatch.
      customType: "regex",
      managerFilePatterns: ["/^constraints/gh-cli\\.txt$/"],
      matchStrings: [
        "renovate:\\s*datasource=github-releases depName=cli/cli\\s*\\n\\s*GH_CLI_VERSION=(?<currentValue>[\\d.]+)",
      ],
      datasourceTemplate: "github-releases",
      depNameTemplate: "cli/cli",
    },
  ],
}

