<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ city.podcast_title }}</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 640px; margin: 2rem auto; padding: 0 1rem; }
    img.art { width: 200px; height: 200px; border-radius: 12px; }
    .btn { display: inline-block; margin: .25rem .5rem .25rem 0; padding: .5rem .9rem;
           border: 1px solid #ccc; border-radius: 8px; text-decoration: none; }
    code { background: #f4f4f4; padding: .1rem .3rem; border-radius: 4px; }
  </style>
</head>
<body>
  <p><a href="{{ site }}/">&larr; All cities</a></p>
  <img class="art" src="artwork.jpg" alt="{{ city.podcast_title }} artwork">
  <h1>{{ city.podcast_title }}</h1>
  <p>{{ city.podcast_description }}</p>
  <p><strong>{{ city.podcast_author }}</strong>{% if city.state %} &middot; {{ city.state }}{% endif %}
     &middot; {{ episode_count }} episodes</p>

  <h2>Subscribe</h2>
  <p>
    {% if has_audio %}<a class="btn" href="{{ city_url }}audio_feed.xml">Audio RSS</a>{% endif %}
    {% if has_video %}<a class="btn" href="{{ city_url }}video_feed.xml">Video RSS</a>{% endif %}
  </p>
  {% if has_audio %}
  <p>Paste a feed URL into your podcast app:</p>
  <p><code>{{ city_url }}audio_feed.xml</code></p>
  {% endif %}
</body>
</html>
