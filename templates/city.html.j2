{% extends "base.html.j2" %}
{% block title %}{{ city.podcast_title }} — {{ config.site_title }}{% endblock %}
{% block content %}
  <p><a class="muted" href="{{ site }}/">← All cities</a></p>

  <div style="display:flex;gap:1.1rem;align-items:flex-start;flex-wrap:wrap;">
    <img src="artwork.jpg" alt="{{ city.podcast_title }} cover"
         width="160" height="160" style="border-radius:12px;flex:none;">
    <div style="flex:1;min-width:240px;">
      <h1 style="margin-bottom:.1rem;">{{ city.podcast_title }}</h1>
      <p class="muted" style="margin:.1rem 0 .6rem;">{{ city.podcast_author }}</p>
      <p style="margin:0;">{{ city.podcast_description }}</p>
    </div>
  </div>

  <h2 style="font-size:1rem;margin:1.6rem 0 .5rem;">Subscribe</h2>
  <div>
    {% if has_audio %}
    <a class="btn btn-primary" href="podcast://{{ audio_noscheme }}">Apple Podcasts</a>
    <a class="btn" href="overcast://x-callback-url/add?url={{ audio_url | urlencode }}">Overcast</a>
    <a class="btn" href="pktc://subscribe/{{ audio_noscheme }}">Pocket Casts</a>
    <a class="btn" href="castro://subscribe/{{ audio_noscheme }}">Castro</a>
    <button type="button" class="btn" id="copy" data-url="{{ audio_url }}">Copy RSS</button>
    {% endif %}
    {% if has_video %}<a class="btn" href="{{ video_url }}">Video RSS</a>{% endif %}
  </div>

  {% if episodes %}
  <h2 style="font-size:1rem;margin:1.8rem 0 .3rem;">Recent meetings</h2>
  <audio id="player" controls preload="none"
         style="width:100%;margin:.4rem 0 .8rem;display:none;"></audio>
  <ul style="list-style:none;margin:0;padding:0;">
    {% for e in episodes %}
    <li style="display:flex;flex-wrap:wrap;align-items:center;gap:.6rem;padding:.5rem 0;border-bottom:1px solid var(--border);">
      {% if e.audio %}
      <button type="button" class="btn play" data-src="{{ e.audio }}" data-title="{{ e.title }}"
              aria-label="Play {{ e.title }}" style="margin:0;padding:.25rem .6rem;">▶</button>
      {% endif %}
      <span style="flex:1;">{{ e.title }}</span>
      {% if e.duration %}<span class="muted" style="font-size:.85rem;">{{ e.duration }}</span>{% endif %}
      {% if e.links %}
      <span class="muted" style="flex-basis:100%;font-size:.85rem;padding-left:2.4rem;">
        {% for label, url in e.links %}<a href="{{ url }}">{{ label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}
      </span>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
  {% endif %}

  <script>
    const copy = document.getElementById('copy');
    if (copy) copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copy.dataset.url);
        copy.textContent = 'Copied!';
      } catch (err) {
        copy.textContent = 'Copy failed';
      }
      setTimeout(() => copy.textContent = 'Copy RSS', 1500);
    });
    const player = document.getElementById('player');
    for (const b of document.querySelectorAll('.play')) {
      b.addEventListener('click', () => {
        player.src = b.dataset.src; player.style.display = 'block'; player.play();
      });
    }
  </script>
{% endblock %}
