{% extends "base.html.j2" %}
{% block title %}{{ city.podcast_title }} Archive — {{ config.site_title }}{% endblock %}
{% block content %}
  <p><a class="muted" href="{{ city_url }}">← Back to feed page</a></p>
  <h1>{{ city.podcast_title }} Archive</h1>
  <p class="tagline">Every retained meeting page for this board, including metadata-only unavailable recordings.</p>

  <ul style="list-style:none;margin:1.5rem 0 0;padding:0;">
    {% for e in episodes %}
    <li style="padding:.8rem 0;border-bottom:1px solid var(--border);display:grid;gap:.25rem;">
      <div style="display:flex;justify-content:space-between;gap:1rem;align-items:baseline;flex-wrap:wrap;">
        <a href="{{ e.page_url }}">{{ e.title }}</a>
        <span class="muted" style="font-size:.92rem;">{{ e.published }}</span>
      </div>
      {% if e.availability %}
      <div class="muted" style="font-size:.85rem;">
        <strong>{{ e.availability.label }}</strong>{% if e.availability.reason %} · {{ e.availability.reason }}{% endif %}
      </div>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
{% endblock %}
