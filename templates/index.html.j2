<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ config.site_title }}</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 760px; margin: 2rem auto; padding: 0 1rem; }
    #q { width: 100%; padding: .6rem; font-size: 1rem; box-sizing: border-box; }
    .filters { margin: .75rem 0; }
    .filters button { margin: 0 .3rem .3rem 0; padding: .3rem .6rem; cursor: pointer; }
    ul { list-style: none; padding: 0; }
    li { padding: .5rem 0; border-bottom: 1px solid #eee; }
    .state { color: #888; font-size: .85rem; }
    footer { margin-top: 2rem; color: #888; font-size: .85rem; }
  </style>
</head>
<body>
  <h1>{{ config.site_title }}</h1>
  <p>{{ config.site_description }}</p>

  <input id="q" type="search" placeholder="Search cities…" autocomplete="off">
  <div class="filters">
    <button data-state="">All</button>
    {% for st in states %}
    <button data-state="{{ st }}">{{ st }}</button>
    {% endfor %}
  </div>

  <ul id="list">
    {% for c in cities %}
    <li data-name="{{ c.podcast_title|lower }} {{ c.slug }}" data-state="{{ c.state or '' }}">
      <a href="{{ site }}/{{ c.slug }}/">{{ c.podcast_title }}</a>
      {% if c.state %}<span class="state">{{ c.state }}</span>{% endif %}
    </li>
    {% endfor %}
  </ul>

  {% if config.site_author %}
  <footer>
    Maintained by
    {% if config.site_author_url %}<a href="{{ config.site_author_url }}">{{ config.site_author }}</a>
    {% else %}{{ config.site_author }}{% endif %}.
  </footer>
  {% endif %}

  <script>
    const q = document.getElementById('q');
    const items = [...document.querySelectorAll('#list li')];
    let state = '';
    function apply() {
      const term = q.value.toLowerCase();
      for (const li of items) {
        const okName = li.dataset.name.includes(term);
        const okState = !state || li.dataset.state === state;
        li.style.display = okName && okState ? '' : 'none';
      }
    }
    q.addEventListener('input', apply);
    for (const b of document.querySelectorAll('.filters button')) {
      b.addEventListener('click', () => { state = b.dataset.state; apply(); });
    }
  </script>
</body>
</html>
