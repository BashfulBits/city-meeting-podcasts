{% extends "base.html.j2" %}
{% block content %}
  <h1>{{ config.site_title }}</h1>
  <p class="tagline">{{ config.site_description }}</p>

  <input id="q" type="search" placeholder="Search cities & boards…" autocomplete="off"
         style="width:100%;padding:.7rem .9rem;font-size:1rem;border:1px solid var(--border);
                border-radius:10px;background:var(--card);color:var(--fg);">
  {% if config.github_repo %}
  <p style="margin:.6rem 0 1.5rem;">
    <a class="muted" href="https://github.com/{{ config.github_repo }}/issues/new?template=add-city.yml">+ Add your city</a>
  </p>
  {% endif %}

  <div id="cities">
    {% for g in groups %}
    <details class="city" data-search="{{ g.search }}"{% if loop.index <= 3 %} open{% endif %}
             style="border-bottom:1px solid var(--border);">
      <summary style="cursor:pointer;padding:.85rem 0;font-weight:600;display:flex;justify-content:space-between;">
        <span>{{ g.label }}</span>
        <span class="muted" style="font-weight:400;">{{ g.feeds|length }} feed{{ '' if g.feeds|length == 1 else 's' }}</span>
      </summary>
      <ul style="list-style:none;margin:0 0 .8rem;padding:0;">
        {% for f in g.feeds %}
        <li class="feed" data-search="{{ f.search }}" style="padding:.35rem 0;">
          <a href="{{ f.url }}">{{ f.label }}</a>
          <span class="muted" style="font-size:.8rem;">
            {% if f.has_audio %}· audio{% endif %}{% if f.has_video %} · video{% endif %}
          </span>
        </li>
        {% endfor %}
      </ul>
    </details>
    {% endfor %}
  </div>
  <p id="empty" class="muted" style="display:none;">No cities match “<span id="term"></span>”.</p>

  <script>
    const q = document.getElementById('q');
    const cities = [...document.querySelectorAll('.city')];
    const empty = document.getElementById('empty');
    q.addEventListener('input', () => {
      const t = q.value.trim().toLowerCase();
      let shown = 0;
      for (const city of cities) {
        const feeds = [...city.querySelectorAll('.feed')];
        const cityMatch = city.dataset.search.includes(t);
        let any = false;
        for (const f of feeds) {
          const show = !t || cityMatch || f.dataset.search.includes(t);
          f.style.display = show ? '' : 'none';
          any = any || show;
        }
        const visible = !t ? true : (cityMatch || any);
        city.style.display = visible ? '' : 'none';
        if (visible) shown++;
        if (t) city.open = true;
      }
      empty.style.display = shown ? 'none' : '';
      document.getElementById('term').textContent = q.value;
    });
  </script>
{% endblock %}
