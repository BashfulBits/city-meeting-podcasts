{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "citypods-llm-dispatch-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-07-12",
  "minify": true,
  "workers_dev": true,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "r2_buckets": [
    {
      "binding": "LLM_QUEUE",
      "bucket_name": "citypods-llm-dispatch"
    }
  ],
  "vars": {
    // The Worker's advertised default route (GET /v1/models, and the fallback when a request
    // omits `model`) -- no longer used to resolve credentials or an upstream URL for a real
    // dispatch. That is entirely `dispatch_limits.json`'s `providers`/`routes_by_id` (compiled
    // from config/provider_limits.yml), keyed by whichever route `dispatchOne`'s ranked selection
    // actually chose for a given request's canonical model (review/41).
    "PROVIDER_NAME": "mistral",
    "UPSTREAM_MODEL": "mistral-large-2512",
    "MODEL_ID": "mistral/mistral-large-2512",
    "MAX_REQUEST_BYTES": "8388608",
    "MAX_RESPONSE_BYTES": "2097152",
    // A dispatch request is one model attempt. Retries would make the caller's CAS-backed
    // 20-attempt/day cap undercount real provider API calls during the cautious rollout.
    "MAX_ATTEMPTS": "1",
    "PROCESSING_TIMEOUT_SECONDS": "900",
    "RETRY_BASE_SECONDS": "60",
    "RETRY_MAX_SECONDS": "3600",
    // Effective deadline: 13m40s of execution, a 14-minute renewable lease, and a 20-second
    // finalization reserve. Fast requests use the separate 90-second lane; long requests use the
    // 12-minute upstream timeout. The Worker refuses to start a candidate that cannot fit.
    "LEASE_DURATION_SECONDS": "840",
    "MAX_EXECUTION_SECONDS": "820",
    "FAST_UPSTREAM_TIMEOUT_SECONDS": "90",
    "UPSTREAM_TIMEOUT_SECONDS": "720",
    "FINALIZATION_RESERVE_SECONDS": "20",
    // The free plan permits only 10ms of CPU for this per-minute cron, so batch size is set from
    // measured production `cpuTime` rather than from provider capacity (review/43).  Measured per
    // invocation: N=1 8.2ms, N=2 9.9ms, N=3 15.5ms -- and per *request* 8.2ms, 4.95ms, 5.2ms.
    // N=2 is both the throughput and the efficiency optimum; N=3 is superlinear (three canonical
    // records live at once) and is worse per request than N=2.  Raising this further needs a
    // delivery change, not a bigger batch.
    "BATCH_CONCURRENCY": "2",
    "MAX_TOTAL_REQUESTS": "2",
    // Keep all failure profiles but sample detailed successful dispatch profiles to reduce log
    // serialization and object churn. Set to 1 temporarily for a full diagnostic tail.
    "PROFILE_SAMPLE_RATE": "0.1",
    // Cloudflare AI Gateway routing. When CLOUDFLARE_ACCOUNT_ID (injected from GitHub Actions secrets
    // during deploy or set in environment) and AI_GATEWAY_ID are present, or when AI_GATEWAY_BASE_URL
    // is set explicitly, outbound LLM calls are automatically proxied through Cloudflare AI Gateway.
    // When unset or empty, calls go directly to provider endpoints.
    "CLOUDFLARE_ACCOUNT_ID": "",
    "AI_GATEWAY_ID": "citypods-dispatch",
    "AI_GATEWAY_BASE_URL": ""
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1.0
  }
}
