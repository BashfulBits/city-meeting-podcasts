{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "citypods-llm-dispatch-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-07-12",
  "minify": true,
  "workers_dev": true,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "r2_buckets": [
    {
      "binding": "LLM_QUEUE",
      "bucket_name": "citypods-llm-dispatch"
    }
  ],
  "vars": {
    // The Worker's advertised default route (GET /v1/models, and the fallback when a request
    // omits `model`) -- no longer used to resolve credentials or an upstream URL for a real
    // dispatch. That is entirely `dispatch_limits.json`'s `providers`/`routes_by_id` (compiled
    // from config/provider_limits.yml), keyed by whichever route `dispatchOne`'s ranked selection
    // actually chose for a given request's canonical model (review/41).
    "PROVIDER_NAME": "mistral",
    "UPSTREAM_MODEL": "mistral-large-2512",
    "MODEL_ID": "mistral/mistral-large-2512",
    "MAX_REQUEST_BYTES": "8388608",
    "MAX_RESPONSE_BYTES": "2097152",
    // AI Gateway first exhausts its own short retry sequence. One final 5xx then gets one
    // durable, minute-scale queue retry; the small cap avoids an unbounded multiplier on the
    // caller's CAS-backed request accounting.
    "MAX_ATTEMPTS": "2",
    "PROCESSING_TIMEOUT_SECONDS": "900",
    "RETRY_BASE_SECONDS": "60",
    "RETRY_MAX_SECONDS": "3600",
    // Effective deadline: 13m40s of execution, a 14-minute renewable lease, and a 20-second
    // finalization reserve. Fast requests use the separate 90-second lane; long requests use the
    // 12-minute upstream timeout. The Worker refuses to start a candidate that cannot fit.
    "LEASE_DURATION_SECONDS": "840",
    "MAX_EXECUTION_SECONDS": "820",
    "FAST_UPSTREAM_TIMEOUT_SECONDS": "90",
    "UPSTREAM_TIMEOUT_SECONDS": "720",
    "FINALIZATION_RESERVE_SECONDS": "20",
    // BATCH_CONCURRENCY is the number of provider calls in flight at once; MAX_TOTAL_REQUESTS is
    // how many jobs one invocation may dispatch in total. Both matter, and raising either alone
    // does nothing: the run loop dispatches min(BATCH_CONCURRENCY, MAX_TOTAL_REQUESTS - done)
    // per batch and exits once MAX_TOTAL_REQUESTS is reached.
    //
    // These were 2 and 2, chosen from measured CPU (N=1 8.2ms, N=2 9.9ms, N=3 15.5ms) against the
    // free plan's 10ms-per-invocation budget. What that reasoning missed is that an invocation
    // holds an *exclusive* lease for its whole duration -- every other cron tick returns
    // lease_busy in ~180ms -- so 2 was not 2 per tick, it was 2 in flight for the entire system
    // until the invocation ended. With a 12-minute upstream timeout and reasoning models running
    // 132-666s, that capped the dispatcher near 10 jobs an hour while rpm/tpm sat nearly unused:
    // nothing was ever allowed in flight to consume them. Measured 2026-08-29: 37 dispatches/hour
    // fell to 5 as call durations grew, with occupancy flat at ~3200 of every 3600 seconds.
    //
    // The 10ms budget is a soft average, not a per-invocation kill, and waiting on a socket costs
    // no CPU -- a 747-second invocation measured 11ms. Since only one invocation is ever
    // dispatching, the fleet average stays far below the budget even when the leaseholder spikes:
    // the other ~119 ticks an hour cost ~0ms each. Extrapolating the measured curve, N=6 is
    // roughly 25-30ms on the leaseholder alone.
    //
    // Start at 6 in flight / 12 per invocation and re-measure `cpuTime` before going further;
    // both are env-overridable, but changing them needs a deploy.
    "BATCH_CONCURRENCY": "6",
    "MAX_TOTAL_REQUESTS": "12",
    // Keep all failure profiles but sample detailed successful dispatch profiles to reduce log
    // serialization and object churn. Set to 1 temporarily for a full diagnostic tail.
    "PROFILE_SAMPLE_RATE": "0.1",
    // Cloudflare AI Gateway routing. When CLOUDFLARE_ACCOUNT_ID (a one-time manual Worker secret --
    // `wrangler secret put CLOUDFLARE_ACCOUNT_ID`, see README.md's Configuration section; it is
    // deliberately *not* injected by the deploy workflow, which would re-trigger Cloudflare's
    // secret-modification/versions conflict, error 10215, on every deploy) and AI_GATEWAY_ID are
    // present, outbound LLM calls are automatically proxied through Cloudflare AI Gateway. When
    // unconfigured, calls go directly to provider endpoints.
    // If the gateway's "Authenticated Gateway" toggle is on, also set the AI_GATEWAY_AUTH_TOKEN
    // secret (`wrangler secret put AI_GATEWAY_AUTH_TOKEN`) or the edge 401s every proxied call
    // before it reaches the provider -- see README.md's Observability & Cloudflare AI Gateway section.
    "AI_GATEWAY_ID": "citypods-dispatch",
    "AI_GATEWAY_BASE_URL": ""
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1.0
  }
}
