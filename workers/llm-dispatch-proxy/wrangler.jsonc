{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "citypods-llm-dispatch-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-07-12",
  "workers_dev": true,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "r2_buckets": [
    {
      "binding": "LLM_QUEUE",
      "bucket_name": "citypods-llm-dispatch"
    }
  ],
  "vars": {
    "PROVIDER_NAME": "mistral",
    "UPSTREAM_BASE_URL": "https://api.mistral.ai",
    "UPSTREAM_CHAT_PATH": "/v1/chat/completions",
    "UPSTREAM_MODEL": "mistral-large-2512",
    "MODEL_ID": "mistral/mistral-large-2512",
    "DISPATCH_INTERVAL_SECONDS": "60",
    "MAX_REQUEST_BYTES": "524288",
    "MAX_RESPONSE_BYTES": "2097152",
    "MAX_QUEUE_SCAN": "1000",
    // A dispatch request is one model attempt. Retries would make the caller's CAS-backed
    // 20-attempt/day cap undercount real Mistral API calls during the cautious rollout.
    "MAX_ATTEMPTS": "1",
    "PROCESSING_TIMEOUT_SECONDS": "900",
    "RETRY_BASE_SECONDS": "60",
    "RETRY_MAX_SECONDS": "3600"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
