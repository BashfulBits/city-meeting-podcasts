{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "citypods-llm-dispatch-v2",
  "main": "src/index.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  // Explicit, not just a dashboard toggle: Workers Logs (covering this script's fetch/scheduled
  // events AND its LLMSchedulerDO's own events -- both are the same deployed script) were
  // enabled by hand in the dashboard on 2026-08-18 to diagnose the payload-storage/reconcile
  // incidents, and reverted to disabled on the next `wrangler deploy` because nothing in source
  // declared the setting -- a deploy without this block resets to wrangler's default rather than
  // preserving whatever was set out-of-band. Declaring it here makes it survive every deploy.
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LLM_SCHEDULER",
        "class_name": "LLMSchedulerDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LLMSchedulerDO"]
    }
  ],
  // Phase 2's scheduled() handler now does real work (claimDispatchWindow + dispatch), so the
  // per-minute cron this design's own request/CPU budget was built around is back -- see
  // "Bounded initial configuration": 1,440 ticks/day, well inside every Free-tier ceiling.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "MAX_BUNDLE_JOBS": "5",
    // Read at most this many indexed queue entries for one capacity-ranked model before moving
    // to the next model. Exact token/lane checks still run only on these small candidate sets.
    "MAX_JOBS_PER_MODEL_CLAIM": "4",
    // When every route of a model that currently has capacity carries a hard_input_ceiling, the
    // claim reads up to this many queue entries (oldest first) to find jobs small enough for one
    // of them, instead of stopping at the first MAX_JOBS_PER_MODEL_CLAIM. Without it a handful of
    // oversized queue-head jobs blocked every smaller job behind them. Bounded, covering-index
    // read: at most ~2 x 32 rows per model per tick, and only for ceiling-bound models.
    "MAX_CANDIDATE_LOOKAHEAD": "32",
    // A route answering 410 Gone (retired model) is stood down this long. A 404 is treated as a
    // transient upstream fault (escalating 15s-5min cooldown) -- see classify.js rule 8.
    "ROUTE_UNAVAILABLE_BLOCK_SECONDS": "21600",
    "MAX_JOBS_PER_ROUTE_PER_BUNDLE": "3",
    "MAX_CONCURRENT_ROUTE_LANES": "5",
    // Raised 25 -> 30 on 2026-09-23: the largest value validateConfig's lease identity allows
    // (DISPATCH_WINDOW + MAX_RESPONSE 720 + FINALIZATION_RESERVE 90 <= LEASE_DURATION 840). The
    // window bounds only when a call may START; a started call is bounded separately by
    // MAX_RESPONSE_SECONDS, and waiting on a provider costs no Worker CPU time.
    "DISPATCH_WINDOW_SECONDS": "30",
    "CRON_TICK_SECONDS": "60",
    // Raised from 2 on 2026-09-20 to let one additional slow bundle overlap. This changes
    // concurrency only; daily bundle/job/write caps remain unchanged.
    "MAX_ACTIVE_BUNDLES": "3",
    // Live telemetry exhausted the eight-call gate while only two of three bundles were active.
    // Per-provider and per-route limits remain the admission safety boundaries.
    "MAX_IN_FLIGHT_LLM_CALLS": "12",
    // 1,400 of the 1,440 daily cron ticks may claim a bundle (validateConfig requires it stay
    // under the tick count). Bundles are a concurrency/overlap knob; the daily dispatch limit is
    // DO_ROWS_CLAIM_STOP below.
    "MAX_BUNDLES_PER_UTC_DAY": "1400",
    // ---------------------------------------------------------------------------------------
    // ---- Daily DO row-write thresholds (runtime; see src/write_budget.js) ------------------
    // The Workers Free plan allows 100,000 billed DO rows written per UTC day, account-wide; past
    // it every DO call fails until 00:00 UTC. The coordinator sums the rows it actually writes
    // (each SQL cursor's rowsWritten, the figure Cloudflare bills) and gates on that total:
    //   < 90,000  everything runs.
    //   >= 90,000 new enqueues, schema retries, scheduled cleanup and retention pruning stop, so
    //             the remaining rows fund dispatch (producers see it via /v2/ingress-status).
    //   >= 97,000 no new leases are claimed.
    //   >= 99,000 acks, retires and cancels are refused too (the client already holds results).
    // In-flight completions, attempt fencing and polls are never refused. The claim stop starts
    // at 97,000 rather than 98,000 because the DO's count can trail Cloudflare's by ~1.3% (and
    // Data Studio edits are invisible to it); raise it once a day of counter-vs-analytics data
    // shows the gap.
    //
    // These three thresholds are the coordinator's code defaults (`_enqueueRowStop`,
    // `_claimRowStop`, `_optionalRowStop`: DO_ROWS_ENQUEUE_STOP 90000, DO_ROWS_CLAIM_STOP 97000,
    // DO_ROWS_OPTIONAL_STOP 99000) and are deliberately NOT declared as vars: Workers Free allows
    // 64 variables per Worker, secrets included, and declaring defaults pushed this Worker to 66,
    // which rejected every deploy from #1846 on. Add a var here only to override a default;
    // tests/test_llm_dispatch_worker_limits.py fails CI before the limit is crossed again.
    // A blast-radius backstop, not the working limit: MAX_BUNDLES_PER_UTC_DAY x MAX_BUNDLE_JOBS.
    "MAX_LEASES_PER_UTC_DAY": "7000",
    // Ingress quota, sized near what dispatch can finish in a day (~20-29 billed rows per job, so
    // ~3,500-5,000 jobs/day fit the row budget).
    "MAX_JOBS_PER_UTC_DAY": "4000",
    // In the Worker's write units (3 + models per job; at most 2 billed rows each, so a full day
    // of ingress is at most 36,000 rows). ~4,000 jobs at the lanes' ~4.5 units/job. Lane
    // reservations compiled from `llm_lanes` must fit inside this.
    "MAX_INGRESS_WRITE_UNITS_PER_UTC_DAY": "18000",
    // Global cap on queued jobs (MAX_QUEUED_JOBS): past it new work waits in the producer, not in
    // the DO. Left at the coordinator's default of 20,000 (`_maxQueuedJobs`), so not declared --
    // see the variable-limit note above.
    // Per-purpose ingress budgets now live in config/site_config.yml's `llm_lanes` block and are
    // compiled into src/ingress_reservations.json by scripts/compile_llm_lanes.py (drift-checked
    // in llm-dispatch-v2-worker-deploy.yml), so this var is gone. It had drifted to reserve
    // capacity under keys -- "topic-tags", "moments" -- that no client purpose ever matched
    // ("topic-tags:tagger", "topic-tags:prelabeler", "r6-moments", "r6-judge"), which withheld
    // 10,000 of 30,000 daily write units from every real lane while being unusable by the lanes
    // it named. Setting INGRESS_PURPOSE_RESERVATIONS here again is still honored, but only as a
    // deliberate incident-time override of the compiled map.
    "ENQUEUE_BATCH_MAX": "1000",
    "POLL_BATCH_MAX": "1000",
    "MAX_RESPONSE_SECONDS": "720",
    "FINALIZATION_RESERVE_SECONDS": "90",
    "LEASE_DURATION_SECONDS": "840",
    "CRON_EXECUTION_LIMIT_SECONDS": "900",
    "MAX_429_RETRIES": "1",
    "MAX_429_BACKOFF_SECONDS": "60",
    "UPSTREAM_CAPACITY_COOLDOWN_SECONDS": "15",
    "UPSTREAM_CAPACITY_MAX_COOLDOWN_SECONDS": "300",
    // AI Gateway handles the fast five-attempt retry series. A final 5xx gets one durable
    // fallback attempt on a later cron tick. The failed route is unavailable for 60 seconds,
    // growing to at most five minutes if this outer retry budget is raised.
    "MAX_UPSTREAM_CAPACITY_RETRIES": "8",
    "MAX_5XX_RETRIES": "1",
    "MAX_5XX_BACKOFF_SECONDS": "300",
    "MAX_ROUTE_BUFFER_SECONDS": "120",
    "UNKNOWN_ATTEMPT_POLICY": "hold",
    "COMPLETED_RETENTION_DAYS": "38",
    // Retention for the DO's two append-only bookkeeping tables. Neither has a B2 counterpart
    // or a client-side reader, so both age out entirely inside the DO. Before this existed
    // nothing ever deleted from either, and `bundles` was full-scanned twice per cron tick --
    // the 2026-08-27 rows-read overage. Zero on either per-tick cap is an emergency pause.
    "BUNDLE_RETENTION_DAYS": "7",
    "ATTEMPT_RETENTION_DAYS": "7",
    "MAX_BUNDLE_PRUNE_PER_TICK": "50",
    "MAX_ATTEMPT_PRUNE_PER_TICK": "50",
    // Terminal-job + B2 object cleanup (purgePendingBatch/confirmPurge). Runs on the cron tick
    // whose UTC minute is a multiple of this, not every minute, since each purged job costs up to
    // two B2 delete subrequests (payload + result keys). 15 costs up to 30, leaving headroom
    // under the 50-subrequest-per-invocation Free ceiling alongside dispatch's own B2 traffic in
    // the same invocation -- validateConfig enforces this bound against both knobs together.
    //
    // Every 10 minutes since 2026-09-24 (60 -> 12 on 2026-09-23, then 10): 6 runs/hour x
    // PURGE_BATCH_LIMIT 15 = 2,160 jobs/day. Completed jobs the client retires by consumption
    // never reach cleanup, so this drains failed jobs, ack fallbacks and the acked backlog; it
    // pauses past DO_ROWS_ENQUEUE_STOP and resumes after the reset. The per-run limit cannot
    // rise (subrequests), so the cadence does.
    "CLEANUP_INTERVAL_MINUTES": "10",
    "PURGE_BATCH_LIMIT": "15",
    // Admission-time allowance subtracted from the dispatch window: a job is admitted only if its
    // planned start + this value <= the window's end. Lowered 20 -> 2 on 2026-09-23. At 20 it
    // left only the first 5s of a 25s window usable, although nothing downstream needs the CALL to
    // finish inside the window -- the executor defers a job only when its START would fall past
    // the window (index.js dispatchOneJob), and a started call is already bounded by
    // MAX_RESPONSE_SECONDS inside the lease. The remaining 2s absorbs claim-to-receipt skew so a
    // job planned at the window's very edge is not routinely deferred_late.
    "ESTIMATED_CALL_DURATION_CEILING_SECONDS": "2",
    // Not secret -- a gateway slug, not a credential. Matched the retired v1 Worker's
    // wrangler.jsonc exactly. gateway.js's resolveProviderCredentials() only routes a call through
    // AI Gateway when both this and the CLOUDFLARE_ACCOUNT_ID secret are present; omitted, it
    // falls back to calling each provider directly with no error, no log line, and no other
    // visible symptom -- confirmed as this deployment's actual state until now: every call landed
    // straight on the provider, never through the gateway, so nothing showed up in the AI Gateway
    // dashboard even though dispatch itself was working (see "Why cron pull, not Queue" for why
    // going through the gateway isn't optional here).
    "AI_GATEWAY_ID": "citypods-dispatch",
    "AI_GATEWAY_BASE_URL": ""
  }
  // Secrets (never plain vars -- set with `wrangler secret put <NAME>`, one time, matching
  // the retired v1 Worker's pattern): BEARER_TOKEN (ingress auth), every provider's
  // API_KEY_ENV from config/provider_limits.yml (e.g. GEMINI_API_KEY, MISTRAL_API_KEY --
  // whichever routes this deployment actually dispatches to), AI_GATEWAY_AUTH_TOKEN (Cloudflare
  // AI Gateway's own "Authenticated Gateway" token, independent of provider keys), CLOUDFLARE_
  // ACCOUNT_ID (needed alongside the AI_GATEWAY_ID var above to build the gateway URL), and the
  // executor's B2 credentials -- B2_ENDPOINT, B2_KEY_ID, B2_APP_KEY, B2_BUCKET (a dedicated
  // least-privilege application key scoped to this design's own B2 prefix, e.g.
  // "llm-dispatch-v2/", per "B2-only payload storage and bounded cleanup" -- never the ingress
  // Worker's credentials, which does not and must not hold any).
}
