    "max_provider_attempts_per_packet_arm": 2,
    "invalid_after_repair_counts_as_zero_hits": true,
    "boundary_tolerance_seconds": 60,
    "route_pause_scope": "Exact physical model route, paused and drained per model.",
    "sibling_provider_traffic": "Not globally drained; latency is descriptive, not a clean comparison.",
    "scoring": "One-to-one match against manually adjudicated eligible provider chapters. Boundary recall requires both a correct human-linked agenda item and a start within 60 seconds. Conditional item accuracy is the correct item rate among timing-matched eligible targets."
  },
