<body>
  <div class="container-fluid">
  <div class="row row-no-padding">
    <div class="col-md-12">
      <div id="header" onclick="window.open('http://www.addisontx.net')" class="hidden-xs hidden-sm">
        <img src="https://swagit-attachments.granicus.com/uploads/customer/header/67/addison.png" id="logo" alt="Addison, TX logo" style="border:0;height:64px;">
      </div>
    </div>
  </div>
  <div class="row row-no-padding">
    <div class="col-md-5">
      <div id="leftcolumnwrap">
        <!--<div id="xs-title" class="hidden-xs hidden-sm"><h1>Jun 01, 2007 Citizen Advisory Committee</h1></div>-->

      <style type="text/css">
        .video-js .vjs-current-time {
          display: block;
        }
      </style>

  <div class="embed-responsive embed-responsive-16by9">
    <div class="embed-responsive-item">
      <div id="player"></div>

      <video-js id="vjs-player" class="vjs-default-skin vjs-big-play-centered vjs-16-9" controls>
      <!--
        <p class="vjs-no-js">
          To view this video please enable JavaScript, and consider upgrading to a
          web browser that
          <a href="https://videojs.com/html5-video-support/" target="_blank">supports HTML5 video</a>
        </p>
      -->

        </video-js>
    </div>
  </div>
<!--
      <video id="player" class="video-js vjs-16-9" controls autoplay preload="auto">
        <p class="vjs-no-js">
          To view this video please enable JavaScript, and consider upgrading to a web browser that
          <a href="http://videojs.com/html5-video-support/" target="_blank">supports HTML5 video</a>
        </p>
      </video>
-->
    	<div id="info" class="hidden-xs hidden-sm" style="background-color:#fff;">
        <ul id="videoTabs" class="nav nav-tabs" role="tablist" style="padding-top:5px;">
          <li role="presentation" class="active"><a href="#video-index" id="video-index-tab" role="tab" data-toggle="tab" aria-controls="video-index" aria-expanded="true">Video index</a></li>
          <li id='focusMode' class="pull-right"><i id='icoViewfinder' class="fa-solid fa-users-viewfinder"></i></li>
        </ul>
        <div id="videoTabContent" class="tab-content" style="padding-top:10px;">
          <div role="tabpanel" class="tab-pane active" id="video-index" aria-labelledby="video-index-tab">
              <div class="media" style="padding-left:8px;">
