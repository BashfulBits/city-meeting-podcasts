              <div role="tabpanel" class="tab-pane" id="share">
                <div class="row">
                  <div class="col-lg-9">
                    <h3>Link</h3>
                      <form class="form-inline">
                        <div class="form-group">
                          <div class="checkbox">
                            <label>
                              Start video at the currently playing item
                              <input style="margin-left:12px;" type="checkbox" id="start_video_at" aria-label="Checkbox to generate shareable link for the currently playing item"> 
                            </label>
                          </div>
                        </div>
                      </form><br>
                    <form>
                      <div class="form-group">
                        <input type="text" class="form-control" id="url" placeholder="URL" value="https://addisontx.new.swagit.com/videos/56029" onclick="this.select();">
                      </div>
                    </form>

                    <style>
                      .social-likes__button_email, .social-likes__button_email:hover, .social-likes__button_email:focus  {
                        color: #ffffff;
                        text-decoration: none;
                      }

                    </style>

                    <h3>Social</h3>

                    <div id="social"></div>

                        <script>
                          jsSocials.shareStrategies["my_popup"] = function(args) {
                            return $("<a>").click(function() {
                              let width = 800; let height = 600; // was this default
                              // let width = 600; let height = 500; // was social-likes-next

                              let left = Math.round(screen.width / 2 - width / 2);
                              let top = 0;
                              if (screen.height > height) {
                                top = Math.round(screen.height / 3 - height / 2);
                              }
                              window.open(args.shareUrl, "MyShareWindow", "width=" + width + ", height=" + height + ", left=" + left + ", top=" + top + ", location=1, resizeable=1, menubar=0, scrollbars=0, status=0, titlebar=0, toolbar=0");
                            });
                          };

                          $("#social").jsSocials({
                            shares: [
                              { share: "email", label: "Email", url: "/videos/56029" }, 
                              { share: "facebook", label: "Facebook", url: "/videos/56029" }, 
                              { share: "twitter", label: "Twitter", url: "/videos/56029" }, 
                              { share: "linkedin", label: "LinkedIn", url: "/videos/56029" }],
                            shareIn: 'my_popup',
                            showCount: false,
                            onRendered: setSocialAttributes()
                          });
                          function setSocialAttributes() {
                            setTimeout(() => {
                                $("#share .jssocials-share-email a").attr({
                                  "aria-label": "Share via email",
                                  "role": "button",
                                  "name": "email-share"
                                }).attr("tabindex", "0")
                                $("#share .jssocials-share-facebook a").attr({
                                  "aria-label": "Share on Facebook",
                                  "role": "button",
                                  "name": "facebook-share"
                                }).attr("tabindex", "0")
                                  .on("keypress", function(event) {
                                    if (event.key === "Enter") {
                                      $(this).click();
                                    }
                                  })
                                $("#share .jssocials-share-twitter a").attr({
                                  "aria-label": "Share on Twitter",
                                  "role": "button",
                                  "name": "twitter-share"
                                }).attr("tabindex", "0")
                                  .on("keypress", function(event) {
                                    if (event.key === "Enter") {
                                      $(this).click();
                                    }
                                  })
                                $("#share .jssocials-share-linkedin a").attr({
                                  "aria-label": "Share on Linkedin",
                                  "role": "button",
                                  "name": "linkedin-share"
                                }).attr("tabindex", "0")
                                  .on("keypress", function(event) {
                                    if (event.key === "Enter") {
                                      $(this).click();
                                    }
                                  })                                
                              }, 100);
                            }
                            function enhanceSocialLinks() {
                              $("#social .jssocials-share-link").each(function () {
                                const $a = $(this);

                                // Always make focusable
                                $a.attr("tabindex", "0")
                                  .attr("role", "button");

                                // Add labels based on class
                                if ($a.closest(".jssocials-share-email").length) {
                                  $a.attr("aria-label", "Share via email");
                                }
                                if ($a.closest(".jssocials-share-facebook").length) {
                                  $a.attr("aria-label", "Share on Facebook");
                                }
                                if ($a.closest(".jssocials-share-twitter").length) {
                                  $a.attr("aria-label", "Share on Twitter");
                                }
                                if ($a.closest(".jssocials-share-linkedin").length) {
                                  $a.attr("aria-label", "Share on LinkedIn");
                                }
                              });
                            }

                            enhanceSocialLinks();

                            const socialObserver = new MutationObserver(function () {
                              enhanceSocialLinks();
                            });

                            socialObserver.observe(document.getElementById("social"), {
                              childList: true,
                              subtree: true
                            });
                          </script>

