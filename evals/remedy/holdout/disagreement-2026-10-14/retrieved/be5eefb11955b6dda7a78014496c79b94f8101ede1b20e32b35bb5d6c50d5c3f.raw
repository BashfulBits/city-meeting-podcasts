    </div> <!-- /left col -->
    <div class="col-md-7">
      <div id="title" class="hidden-xs hidden-sm"><h1>Aug 22, 2023 2024 Capital Bond Streets &amp; Transportation Subcommittee Meeting </h1></div>
        <div id="contentwrap">
          <div style="background-color:#fff;padding:10px;">
          <ul id="myTabs" class="my-tabs nav nav-tabs hidden-xs hidden-sm" role="tablist">
