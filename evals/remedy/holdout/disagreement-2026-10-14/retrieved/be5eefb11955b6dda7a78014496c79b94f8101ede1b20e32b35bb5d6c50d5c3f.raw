        player.src({type: "application/x-mpegURL", src: "https://archive-stream.granicus.com/OnDemand/_definst_/mp4:swagitVideo/dallastx/cf1eb012-e2a1-445d-8996-95c91e2f79b1.mp4/playlist.m3u8"});
    }(window, window.videojs));

    player.on("timeupdate", function(e) {
      var vtime = player.currentTime();

      updateStartAtDisplay(vtime);

      if ((vtime > (lastPos + 1)) || (vtime < (lastPos - 1))) {
        $("#transcript-fragments a").css('font-weight', '400');

        $("#transcript-fragments a").filter(function() {
          return parseFloat($(this).attr("data-ts")) <= vtime;
        }).last().css('font-weight', 'bold');
        lastPos = vtime;
      }
    });

    // Manually seeking while paused doesn't fire timeupdate, so the
    // "Start Video At" display/link would otherwise be stale (GUB-89911).
    player.on("seeked", function(e) {
      updateStartAtDisplay(player.currentTime());
    });

    jQuery(".playerControl").click(function (event) {
