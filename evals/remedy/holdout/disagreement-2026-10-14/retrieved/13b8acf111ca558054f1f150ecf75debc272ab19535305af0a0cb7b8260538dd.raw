  function partnerPlay(id) {
    $( "a.playerControl[data-id=" + id + "]").trigger("click")
  }

  $('#start_video_at').change(function() {
    if(this.checked) {
      var currentSeconds = Math.round(go_for_ng ? player.currentTime() : jwplayer("player").getPosition());
        $('#url').val(base_url + "?ts=" + currentSeconds);
    } else {
      $('#url').val(base_url);
