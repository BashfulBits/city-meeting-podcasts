    	<div id="info" class="hidden-xs hidden-sm" style="background-color:#fff;">
        <ul id="videoTabs" class="nav nav-tabs" role="tablist" style="padding-top:5px;">
          <li role="presentation" class="active"><a href="#video-index" id="video-index-tab" role="tab" data-toggle="tab" aria-controls="video-index" aria-expanded="true">Video index</a></li>
        </ul>
        <div id="videoTabContent" class="tab-content" style="padding-top:10px;">
          <div role="tabpanel" class="tab-pane active" id="video-index" aria-labelledby="video-index-tab">
              <div class="media" style="padding-left:8px;">
    <div class="media-left media-top">
      <span class="playerControl" data-id="23907560" data-ts="254" data-end-ts="8412" data-title="2024 Bond Task Force Community Bond Task Force Meeting on August 15, 2023."></span>
    </div>
    <div class="media-body">

      <div class="media-heading" id="item-23907560">
          <a class="playerControl" data-id="23907560" data-ts="254" data-end-ts="8412" data-title="2024 Bond Task Force Community Bond Task Force Meeting on August 15, 2023." href="/play/269608/254"><span class="glyphicon glyphicon-play-circle" style="color: red;" aria-hidden="true"></span> 2024 Bond Task Force Community Bond Task Force Meeting on August 15, 2023.</a>
