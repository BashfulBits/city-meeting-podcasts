    player.ready(()=>{
      // rename captions here
      player.textTracks().addEventListener('addtrack', (e) => {
        setTimeout(() => {
          const track = e.track; // Ensure correct access
          if (track.kind == 'captions') {
            let labelToRemove;
            switch (track.label) {
              case 'CC1':
                track.label = 'English';
                break;
              case 'CC3':
                track.label = 'Español';
                break;
              case 'cc708_1':
                labelToRemove = 'cc708_1';
                break;
              case 'cc708_2':
                labelToRemove = 'cc708_2';
                break;
