                        <script type="text/javascript">
$(document).ready( function() {
    var embedded = true;

            embedded = false;
    
    captionsArray = [];

    if (flowplayer != null && (flowplayer.instances == null)) {
        flowplayer().on('captions-enabled', function(e, data) {
            $('.flow-captions').addClass('fp-shown');

            /*
             * If video is fullscreen && should be displaying Granicus Captions
             * display them.
             */
            if ($('#video>.is-fullscreen').length > 0 && isGranicusCaptions()) {
                // If Phone, Tablet, IE, or Edge use iframe instead of embed
                                    showEmbeddedGranicusCaptions();
                            }

            if (embedded) {
                if (isGranicusCaptions()) {
                                            showEmbeddedGranicusCaptions();
                                    } else {
                    $(".fp-captions").show();
                }
            } else {
                                    $("#captions").show();
                            }
        });

        flowplayer().on('fullscreen', function(e, data){

            if (isGranicusCaptions()) {
                /*
                 * If granicus captions are already turned on before going to full screen,
                 * we need to turn them on when going to fullscreen as well.
                */
                if (($('.flow-captions>embed').length > 0 && $('.flow-captions>embed').is('visible')) ||
                        $('.fp-captions>iframe').length > 0) {
                    // If Phone, Tablet, IE, or Edge use iframe instead of embed
                                            showEmbeddedGranicusCaptions();
                                    }
            }
        });

        flowplayer().on('captions-disabled', function(e, data) {
            $('.fp-captions').removeClass('fp-shown');

            if (embedded) {
                $(".fp-captions").hide();
                $('.fp-captions').removeClass('fp-shown');
            } else {
                                    $("#captions").hide();
                            }
        });

                    flowplayer().on('cuepoint', function(e, data, cuepoint) {
                if (cuepoint.subtitle){
                    pushCaption(cuepoint.subtitle.text);
                    renderCaptions();
                }
            });

            flowplayer().on('seek ', function(e, data, position) {
                clearCaptions();
                fillCaptionsArray(position);
            });

            // Pushes the next caption onto the captionsArray and removes the oldest item.
            var pushCaption = function(text) {
                for (var i = 1; i < 3; i++) {
                    var swapText = captionsArray[i];
                    captionsArray[i-1] = swapText;
                }

                captionsArray[2] = text;
            };

            // Renders the captionsArray to the user.
            var renderCaptions = function() {
                for (var i = 1; i <= 3; i++) {
                    $('div#captions-line-'+i).html(captionsArray[i-1]);
                }
            };

            // Clears the captionsArray.
            var clearCaptions = function() {
                // Loop through array to clear it out.
                for (var i = 0; i < 3; i++) {
                    captionsArray[i] = "";
                }

                // Render the blank captions array to clear out the UI.
                renderCaptions();
            };

            // Fills the captionsArray with the last captions.
            var fillCaptionsArray = function(position) {
                var subtitlesArray = flowplayer().subtitles;
                var nextIndex = searchSubtitleArray(subtitlesArray, position);

                if (nextIndex != -1) {
                    // Fill the captions with the last 3 subtitles. if we're past 3 subtitles.
                    if (nextIndex < 3) {
                        for (var i = 0; i < nextIndex; i++) {
                            pushCaption(subtitlesArray[i].text);
                        }
                    } else {
                        // else grab the last 3 captions.
                        pushCaption(subtitlesArray[nextIndex - 3].text);
                        pushCaption(subtitlesArray[nextIndex - 2].text);
                        pushCaption(subtitlesArray[nextIndex - 1].text);
                    }

                    renderCaptions();
                }
            };

            // Searches the subtitle array for the index of the next subtitle.
            // Returns -1 if it cannot locate the next index.
            var searchSubtitleArray = function(subtitleArray, position) {
                for (var i = 0; i < subtitleArray.length; i++) {
                    if (position < subtitleArray[i].startTime) {
                        return i;
                    }
                }

                return -1;
            };
        

        /*
         * Granicus Captions for desktop devices
         */
        var showEmbeddedGranicusCaptions = function () {
            removeEmbedGranicusCaptions();
            $(".fp-captions").show();
            $('.fp-captions').append('<embed width="80%" height="90" style="border: none;" ' +
                                        'src="Caption URL"/>');
        }

        /*
         * Granicus Captions for mobile devices
         * (uses iframe instead of embed for scrolling purposes in IOS)
         */
        var showMobileGranicusCaptions = function () {
            removeEmbedGranicusCaptions();
            $(".fp-captions").show();
            $('.fp-captions').append('<iframe id="fullscreenCaptionsSpan" width="80%" height="90" style="border: none;" ' +
                                        'src="Caption URL"/>');
        }

        /*
         * Clears any existing Granicus Caption boxes.
         */
        var removeEmbedGranicusCaptions = function () {
            $('.fp-captions>embed').remove();
            $('.fp-captions>iframe').remove();
        }

        /*
         * Determines if the player template should be displaying Granicus Captions
         */
        var isGranicusCaptions = function () {
                            return false;
                    }
    }
});
</script>
        <script type="text/javascript">
            // Set up video and player template values
                            var isLive = false;
            
                            var shouldAutoplay = false;
            
                            var captionsEnabled = true;
            
                            var granicusCaptions = false;
            
            // Configure flowplayer-7-only variables and functions
             
                /* var fpEngine = (/rv:11.0/i.test(navigator.userAgent)) && isLive ? "flash" : "html5"; */
                var fpEngine = (/rv:11.0/i.test(navigator.userAgent)) && isLive ? "flash" : /iPhone|iPad|iPod|Macintosh/i.test(navigator.userAgent) ? "html5" : "hlsjs";
                var showCaptions = function() {
                    var captions = $('#captions');

                    if (captions.css('display') === 'none') {
                        var title = $('.title');
                        var menu = $('.menu');
                        var content_pane = $('#content-pane');

                        captions.css('display', 'block');
                        title.css('top', title.position().top + captions.height());
                        menu.css('top', menu.position().top + captions.height());
                        content_pane.css('top', content_pane.position().top + captions.height());
                    }
                }
                var hideCaptions = function() {
                    var captions = $('#captions');

                    if (captions.css('display') !== 'none') {
                        var title = $('.title');
                        var menu = $('.menu');
                        var content_pane = $('#content-pane');

                        captions.css('display', 'none');
                        title.css('top', title.position().top - captions.height());
                        menu.css('top', menu.position().top - captions.height());
                        content_pane.css('top', content_pane.position().top - captions.height());
                    }
                }
                var pushCaption = function(text) {
                    for (var i = 1; i < 3; i++) {
                        captionsArray[i-1] = captionsArray[i];
                    }

                    captionsArray[2] = text;
                }
                var renderCaptions = function() {
                    for (var i = 1; i <= 3; i++) {
                        $('div#captions-line-'+i).html(captionsArray[i-1]);
                    }
                }
                var clearCaptions = function() {
                    captionsArray = ['', '', ''];
                    renderCaptions();
                }

                // Configuring flowplayer 7 options
                flowplayer.conf = {
                    engine: fpEngine,
                    swf: "//d1rw50yn65615p.cloudfront.net/b7a83b5b6c9052aff5aba4c2a012c9870926b3d9/assets/flowplayer/flowplayer.swf",
                    swfHls: "//d1rw50yn65615p.cloudfront.net/b7a83b5b6c9052aff5aba4c2a012c9870926b3d9/assets/flowplayer/flowplayerhls.swf",
                    hlsjs: {
                        safari: true,
                        chrome: true
                    },
                    mutedAutoplay: false,
                    native_fullscreen: true,
                    fullscreen: true,
                    share: false,
                    splash: window.splash_image,
                    live: isLive,
                    autoplay: shouldAutoplay,
                    cuepoints: [{"time":8,"type":"Agenda","id":"293630"},{"time":24,"type":"Agenda","id":"293631"},{"time":71,"type":"Agenda","id":"293632"},{"time":170,"type":"Agenda","id":"293633"},{"time":410,"type":"Agenda","id":"293635"},{"time":449,"type":"Agenda","id":"293637"},{"time":963,"type":"Agenda","id":"293638"},{"time":1944,"type":"Agenda","id":"293639"},{"time":2469,"type":"Agenda","id":"293640"},{"time":3512,"type":"Agenda","id":"293642"},{"time":3570,"type":"Agenda","id":"293643"},{"time":4101,"type":"Agenda","id":"293645"},{"time":4105,"type":"Agenda","id":"293646"},{"time":4329,"type":"Agenda","id":"293647"},{"time":4852,"type":"Agenda","id":"293648"},{"time":4964,"type":"Agenda","id":"293649"},{"time":5364,"type":"Agenda","id":"293650"},{"time":6182,"type":"Agenda","id":"293651"},{"time":6189,"type":"Agenda","id":"293652"},{"time":6693,"type":"Agenda","id":"293653"},{"time":7788,"type":"Agenda","id":"293654"},{"time":7884,"type":"Agenda","id":"293655"},{"time":8092,"type":"Agenda","id":"293656"}],
                    volume: 1
                };

                function SetPlayerPosition(time) {
                    return flowplayer().seek(time.replace(":", ''));
                }

                document.addEventListener("DOMContentLoaded", function() {
                    flowplayer(function(api, root) {
                        
                                            });
                });
            
            
            var clearErrorMessages = function() {
                $('.fp-message').hide();
                $('.responsive-error span').text('');
                $('.flowplayer').show();
                $('.responsive-error').hide();
            }

            var showErrorMessage = function(errorMessage) {
                $('.responsive-error span').text(errorMessage);
                $('.flowplayer').hide();
                $('.responsive-error').show();
            }

            var setEmbedCode = function(code) {
                $('#embed-code').val(code);
            }

            var setCurrentItem = function(item) {
                $('#current-index-title').html(item);
            }

            document.addEventListener("DOMContentLoaded", function() {
                flowplayer(function(api, root) {
                    api.on('ready', function(){
                        clearErrorMessages();
                    });

                    api.on('error', function (e, api, err) {
                        var errorMessage = null;

                        if (/rv:11.0/i.test(navigator.userAgent)) {
                            // Use built in Flowplayer errors for IE.
                        } else {
                            if (err.code == 4) {
                                errorMessage = "This video file was not found, please try again later.";
                            } else if (err.code == 2) {
                                errorMessage = "Network error occurred, please refresh the page and try again.";
                            } else {
                                errorMessage = $('.fp-message').text();
                            }

                            showErrorMessage(errorMessage);
                        }
                    });
                });
            })
        </script>
    <script type="text/javascript">
    function swapIndexContent(targetID) {
        var visibleIndexContentClass = 'index-content-visible';
        $('.' + visibleIndexContentClass).removeClass(visibleIndexContentClass);
        $('#' + targetID).addClass(visibleIndexContentClass);
    }

    function slidePane(targetPane) {
        var visibleSlidePaneClass = 'sliding-pane-visible';
        document.getElementsByClassName(visibleSlidePaneClass)[0].classList.remove(visibleSlidePaneClass);
        document.getElementById(targetPane).classList.add(visibleSlidePaneClass);
    }

    $('#navigation > .navigation-element').on("click", function() {
        $('#embed-mobile-document').remove();
        $('#ios-mobile-document').remove();
        cycleMenuHighlighting('.navigation-element.', 'selected', $(this));
        $('#navigation > .navigation-element').attr('aria-selected', 'false');
        $(this).attr('aria-selected', 'true');
    });
</script>
    <script type="text/javascript">

        const recordedItems = document.querySelectorAll('.index-point[role="link"]');
        recordedItems.forEach(recordedItem => {
            recordedItem.addEventListener('keydown', indexItemClickHandler);
        });
        function indexItemClickHandler(event) {
            const key = event.key;
            const targetPoint = event.currentTarget;
            switch (key) {
                case 'Enter':
                targetPoint.click();
                    break;
                default:
                    return;
            }
        }
        $('.index-point').on("click", function() {
            var that = $(this);

                            flowplayer().seek(that.attr("time"));
            
            cycleMenuHighlighting('.index-point.', 'selected', that);
        });
    </script>
    <script>
    var lastSliderStart = 0;
    var lastSliderStop = null;

    $(document).ready(function(){
        // Display Embed Code on page load | KS | CSI-321
        updateEmbedCodeOnChange();
    });

    function setEmbedCode(width, height, startTime, stopTime, autoStart)
    {
        var autoStartCode = '&autostart=' + (autoStart ? 1 : 0);
        var startCode = '', embedCode = '';
        width = width + 'px';
        height = height + 'px';
                  if(startTime !== null && startTime !== 0)
          {
            startCode = '&entrytime=' + startTime;
          }

          var stopCode = '';
          if(stopTime !== null)
          {
            stopCode = '&stoptime=' + stopTime;
          }
          embedCode = '<embed width="' + width + '" height="' + height + '" '
                        + 'frameborder="0" allowfullscreen="true" src="'
                        + window.location.href.substring(window.location.protocol.length) 
                        + startCode + stopCode + autoStartCode +'&embed=1"></embed>';
        
        $('#embed-link-desktop-input').val(embedCode);
    }
    function updateEmbedCodeOnChange()
    {
                    var start = "", stop = "";
                            var sliderValue = $( "#durationSlider" ).slider( "values", 0 );
                start = convertHHMMSSToSeconds($( "#embed-start-time-input" ).val());
                stop = convertHHMMSSToSeconds($( "#embed-end-time-input" ).val());
                        var width = $('#embed-width-input')[0].value;
            var height = $('#embed-height-input')[0].value;
            var autostart = $('#embed-autostart-checkbox')[0].checked
            setEmbedCode(width, height, start, stop, autostart);
            }

    // Removed slider & added inputs for entry & stop time, ticket no. GUB-67653
            $("#embed-end-time-input").val(convertSecondsToHHMMSS(8102));
        function convertSecondsToHHMMSS(totalSeconds){
            const hours = Math.floor(totalSeconds / 3600);
            const minutes = Math.floor((totalSeconds % 3600) / 60);
            const seconds = totalSeconds % 60;

            const formattedHours = String(hours).padStart(2, '0');
            const formattedMinutes = String(minutes).padStart(2, '0');
            const formattedSeconds = String(seconds).padStart(2, '0');

            return `${formattedHours}:${formattedMinutes}:${formattedSeconds}`;
        }
        function convertHHMMSSToSeconds(duration){
            if(duration == "" || duration == null || duration == undefined){
                return 0;
            }
            var time = duration;
            var parts = time.split(':');
            return (parseInt(parts[0]) * 3600) + (parseInt(parts[1]) * 60) + parseInt(parts[2]);
        }
        function changeDuration(durationInput){
            const id = durationInput.attr('id');
            let durationInputInSecs = convertHHMMSSToSeconds(durationInput.val());

            let minValInSec = 0;
            let maxValInSec = 8102;

            if(id == "embed-start-time-input"){
                maxValInSec = convertHHMMSSToSeconds($("#embed-end-time-input").val());
                if(durationInputInSecs > maxValInSec){
                    durationInput.val(convertSecondsToHHMMSS(maxValInSec));
                }
                if(durationInputInSecs < minValInSec){
                    durationInput.val(convertSecondsToHHMMSS(minValInSec));
                }
            } else if(id == "embed-end-time-input"){
                minValInSec = convertHHMMSSToSeconds($("#embed-start-time-input").val());
                if(durationInputInSecs < minValInSec){
                    durationInput.val(convertSecondsToHHMMSS(minValInSec));
                }
                if(durationInputInSecs > maxValInSec){
                    durationInput.val(convertSecondsToHHMMSS(maxValInSec));
                }
            }
            let start = convertHHMMSSToSeconds($( "#embed-start-time-input" ).val());
            let stop = convertHHMMSSToSeconds($( "#embed-end-time-input" ).val());
            if(lastSliderStart != start)
            {
                                    flowplayer().seek(start);
                                lastSliderStart = start;
            } else if(lastSliderStop != stop)
            {
                                    flowplayer().seek(stop);
                                lastSliderStop = stop;
            }
            updateEmbedCodeOnChange();
        }
        $(".embed-duration-input").inputmask(
            "99:59:59", 
            {
                placeholder: "00:00:00",
                insertMode: false,
                showMaskOnHover: false,
                definitions: {
                    '5': {
                        validator: "[0-5]",
                        cardinality: 1
                    },
                }
            }
        );
    
    </script>
                <script type="text/javascript">
                    function createDesktopDocument(slideLink) {
                        var documentToolbarItem     = createDiv({ class: 'documents-toolbar-item', "data-url": slideLink }),
                            documentToolbarItemIcon = createDiv({ class: 'documents-toolbar-icon fa fa-file fa-lg' }),
                            documentToolbarItemText = createDiv({ class: 'documents-toolbar-text', text: 'Slide'});

                        $('#index-documents-toolbar').append(documentToolbarItem);
                        documentToolbarItem.append(documentToolbarItemIcon);
                        documentToolbarItem.append(documentToolbarItemText);
                        documentToolbarItem.on("click", setDocumentsToolbarItemListener);
                        documentToolbarItem.trigger('click');
                    }

                    function createDiv(divProperties) {
                    return $('<div/>', divProperties);
                    }

                    function createMobileDocument(slideLink) {
                    var documentGroup          = $('<a/>', { class: 'document-group' }),
                        documentIconBackground = createDiv({ class: 'document-icon-gray flex-col-center' }),
                        documentIcon           = createDiv({ class: 'documents-toolbar-icon fa fa-file fa-lg' }),
                        documentLabel          = createDiv({ class: 'document-label flex-col-center', text: 'Slide' }),
                        documentLink           = createDiv({ class: 'document', 'data-url': slideLink }),
                        documentText           = createDiv({ class: 'document-text', text: 'Slide' }),
                        mobileDocumentList     = $('#documents');
                    mobileDocumentList.prepend(documentGroup);
                    documentGroup.append(documentLabel);
                    documentGroup.append(documentLink);
                    documentLink.append(documentIconBackground);
                    documentIconBackground.append(documentIcon);
                    documentLink.append(documentText);
                    documentLink.on("click", setDocumentsToolbarItemListener);
                    var noDocumentsMessage = $('#no-documents-available');
                    if (noDocumentsMessage.length) {
                        noDocumentsMessage.remove();
                    }
                    }

                    function cycleDocumentView(url, mobile, target) {

                        var isIphone = navigator.userAgent.indexOf("iPhone") != -1 ;
                        var isIpod = navigator.userAgent.indexOf("iPod") != -1 ;
                        var isIpad = navigator.userAgent.indexOf("iPad") != -1 ;
                        // now set one variable for all iOS devices
                        var isIos = isIphone || isIpod || isIpad ;
                        if (mobile) {
                            if (isIos) {
                                loadIOSEmbed(url, target, true);
                            } else {
                                loadEmbed(url, target, true);
                            }
                        } else {
                            target.empty();
                            loadEmbed(url, target, false);
                        }
                    }

                    function cycleMenuHighlighting(elementClass, selectedElementClass, selectedElement) {
                        $(elementClass + selectedElementClass).removeClass(selectedElementClass);
                        selectedElement.addClass(selectedElementClass);
                    }

                    function loadEmbed(url, target, insertBefore) {
                        var identifier   = insertBefore ? target : 'documents-viewer-iframe',
                            embedElement = $('<embed>', { src: url,
                                                        id:  identifier,
                                                        type: 'text/html' });
                        insertBefore ? embedElement.insertBefore('#navigation') : embedElement.appendTo(target);
                    }

                    function loadIOSEmbed(url,target,insertBefore){
                        window.open(url, "_blank");
                    }

                    function markCurrentIndexItem(cuepoint) {
                    if (cuepoint.type == "Document") {
                        var slideLink     = location.protocol + "//" + location.host + '/MetaViewer.php?meta_id=' + cuepoint.id;

                        if ($('.documents-default-document').is(":visible")) {
                            var existingSlide = $('.documents-toolbar-item > .documents-toolbar-text:contains("Slide")');
                            if (existingSlide.length) {
                                existingSlide.parent().remove();
                            }
                            createDesktopDocument(slideLink);
                        } else {
                            var existingSlide = $('.document > .document-text:contains("Slide")');
                            if (existingSlide.length) {
                                existingSlide.parent().parent().remove()
                            }
                            createMobileDocument(slideLink);
                        }
                    }
                    var indexPoints = $('.index-point');
                    indexPoints.each(function(index, element) {
                        if (cuepoint.time >= element.attributes.time.value &&
                            (index == indexPoints.length - 1 || cuepoint.time < indexPoints[index + 1].attributes.time.value)) {
                            cycleMenuHighlighting('.index-point.', 'selected', $(element));
                        }
                    });
                    }

                    function setDocumentsToolbarItemListener() {
                        var that                   = $(this),
                            documentURL            = that.data('url'),
                            mobileDocumentDisplay  = 'embed-mobile-document',
                            desktopDisplay         = $('.documents-default-document');

                        if (that.hasClass('streaming-help')){
                            window.open(that.data('url'));
                        } else if (desktopDisplay.is(":visible")) {
                            cycleMenuHighlighting('.documents-toolbar-item.', 'selected-document', that);
                            cycleDocumentView(documentURL, false, desktopDisplay);
                        } else {
                            cycleDocumentView(documentURL, true, mobileDocumentDisplay);
                        }
                    }

                    function setShareLinkAndCheckRadio(currentItem, that) {
                        $('.share-info-item > input:checked').prop('checked', false);
                        var currentSelectedItemID = $('.index-point.selected').data('id');
                        var currentLocation = location.protocol + '//' + location.host + location.pathname;
                        if (currentItem && currentSelectedItemID) {
                            var shareLink = currentLocation + '?meta_id=' + currentSelectedItemID;
                        } else {
                            var shareLink = currentLocation;
                        }
                        $('#share-link-desktop > input').val(shareLink);
                        $(that).prop('checked', true);
                    }

                    
                    $(document).ready(function() {
                        
                    
                    if ($('documents-default-document'))

                    $('.document, .documents-toolbar-item, #navigation-mobile-display-agenda, #navigation-mobile-display-minutes').on("click", setDocumentsToolbarItemListener);

                    var currentLocation = location.protocol + '//' + location.host + location.pathname;
                    $('#share-link-desktop > input').val(currentLocation);

                    if (flowplayer != null && (flowplayer.instances == null))
                    {
                        flowplayer().on('cuepoint', function(e, api, cuepoint) {
                            markCurrentIndexItem(cuepoint);
                        });

                        flowplayer().on('seek', function(e, api, time) {
                            markCurrentIndexItem({ time: time, type: "Seek" });
                        });

                        flowplayer().on('fullscreen', function(e, data){
                        var desktopDocument = $('.documents-default-document');
                        if (desktopDocument.is(':visible')) {
                            desktopDocument.hide();
                        }
                        });

                        flowplayer().on('fullscreen-exit', function(e, api) {
                        var desktopDocumentToolbar = $('#index-documents-toolbar');
                        if (desktopDocumentToolbar.is(':visible')) {
                            $('.documents-default-document').show();
                        }
                        });
                    }

                    
                    const tabs = document.querySelectorAll('.documents-toolbar-item[role="tab"]');
                    if (tabs.length > 0) {
                        if(!tabs[0].classList.contains('streaming-help')){
                            tabs[0].setAttribute('aria-selected', 'true');
                        }
                    }
                    tabs.forEach(tab => {
                        tab.addEventListener('focus', (event) => {
                            tab.addEventListener('keydown', (event) => {
                                if (event.key === 'Enter' || event.key === ' ') {
                                    const previouslySelectedTab = document.querySelector('.documents-toolbar-item[aria-selected="true"]');
                                    if (previouslySelectedTab) {
                                        previouslySelectedTab.setAttribute('aria-selected', 'false');
                                    }
                                    tab.click();
                                    tab.attributes['aria-selected'].value = true;
                                }
                            });
                        });
                    });

                    });
                </script>
            </body>
</html>