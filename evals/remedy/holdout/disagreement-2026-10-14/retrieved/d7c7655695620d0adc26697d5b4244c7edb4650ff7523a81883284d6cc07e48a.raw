            <style type="text/css">
    *, *:before, *:after {
        box-sizing: inherit;
    }

    html {
        font-family: 'Open Sans', sans-serif;
        font-size: 62.5%;
        font-weight: 300;
        font-style: normal;
        font-stretch: 100%;
