        }

        #navigation-display-download,
        #navigation-display-clip {
            display: none;
        }

        #share {
          justify-content: center;
        }

        #share-info-desktop {
            width: 100%;
            margin: 10px;
            padding: 0px 5px;
        }

        #share-link-desktop {
