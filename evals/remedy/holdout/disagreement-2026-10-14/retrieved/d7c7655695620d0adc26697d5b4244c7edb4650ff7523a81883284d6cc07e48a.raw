    }

    .index-point:hover {
        text-decoration: underline;
        background-color: #F2F2F2;
    }
    .index-point.selected {
        background-color: #23527c;
        color: #ffffff;
    }

    /* Hide Player controls on Live Streams */
    .is-live .fp-player .fp-ui .fp-controls .fp-playbtn,
    .is-live .fp-player .fp-ui .fp-controls .seek-backward,
    .is-live .fp-player .fp-ui .fp-controls .seek-forward{
