    }

    .grid {
        display: flex;
        overflow: hidden;
        height: 100%;
    }

    #header {
        min-height: 75px;
        -ms-grid-column: 1;
        -ms-grid-row: 1;
        grid-area: index-header;
    }

    #header h1 {
        line-height: 7.5rem;
    }

    #index {
        grid-area: index-content;
        -ms-grid-column: 1;
        -ms-grid-row: 4;
        overflow-y: auto;
        overflow-x: hidden;
        flex-direction: column;
        justify-content: flex-start;
    }

    #index .current-item {
        min-height: 44px;
        text-align: left;
        border-bottom: 1px solid #333333;
        background-color: #FFFFFF;
        font-size: 16px;
        line-height: 22px;
        letter-spacing: 5%;
